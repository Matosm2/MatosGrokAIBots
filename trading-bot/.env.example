# Copy to .env and fill in secrets. Never commit real keys.

# paper | live  — default paper: logs intended orders, no Binance placement
TRADING_MODE=paper

# Binance Spot API (trade-only; withdraw DISABLED). Leave empty for paper.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_BASE_URL=https://api.binance.com

# Shared secret for TradingView webhook (header X-Webhook-Secret or JSON "secret")
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Quote asset for pairs
DEFAULT_QUOTE=USDT

# --- Balanced risk defaults ---
RISK_PER_TRADE_PCT=2.5
MAX_POSITION_PCT=12
MAX_OPEN_POSITIONS=4
MAX_DAILY_LOSS_PCT=5
ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT

# Paper mode starting equity (USDT)
PAPER_EQUITY_USDT=10000

# Logging
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
