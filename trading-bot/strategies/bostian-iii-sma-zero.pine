//
// Strategy overview
// -----------------
// Bostian Intraday Intensity Index (III) zero-line SMA crossover strategy.
// Authorized paper seat for BTCUSDT @ 4h (Stage 17, PR#45: 1.412× B&H, n=40).
// STRICT: smaLen=21 ONLY (not sma34). Separate named strategy (do not combine).
//
// Formula:
//   rng = high - low
//   iii = rng == 0 ? 0.0 : ((2 * close - high - low) / rng) * volume
//   iiiS = ta.sma(iii, smaLen)
// Long entry:  ta.crossover(iiiS, 0)
// Long exit:   ta.crossunder(iiiS, 0) + optional ATR stop/trail strategy.exit
//
// Bar close only (process_orders_on_close = true).
// Exits use strategy() position / price — does NOT read bot open-state or exchange positions.
//
// Sizing (PAPER_PARAMS locked):
//   Buys: OMIT qty / qty_pct in webhook JSON -> bot Balanced default 2.5% risk.
//   Sells: qty_pct = 12 (clears max position; sells not capped by 2.5%).
//
// alert_id shape (PAPER_PARAMS locked):
//   {strategy_id}-{SYMBOL}-{{time}}-{buy|sell}
//   e.g. bostian-iii-sma-zero-BTCUSDT-{{time}}-buy
//
// Secret:
//   Auth via header X-Webhook-Secret (preferred) or body secret.
//   Do NOT embed secrets in committed Pine; Trading wires secret at runtime.
//
// cooldown_bars
// -------------
// Number of bars AFTER an exit (SELL) before a new BUY / re-entry is allowed.
// Default = 6 (matches ema-rsi paper default). Set to 0 to disable.
// This is NOT a cooldown after entries.
//
// Stops
// -----
// Base census exit is signal-only (zero crossunder).
// Optional ATR strategy.exit included (disabled by default).
// Real LIVE execution remains strictly OFF; a hard stop brief is required before live.

//@version=5
strategy(
     title              = "Bostian III SMA Zero [PAPER ONLY - LIVE OFF]",
     shorttitle         = "bostian-iii-sma21",
     overlay            = false,
     initial_capital    = 1000,
     default_qty_type   = strategy.percent_of_equity,
     default_qty_value  = 2.5,
     commission_type    = strategy.commission.percent,
     commission_value   = 0.1,
     pyramiding         = 0,
     process_orders_on_close = true
 )

// ——— Inputs ———
smaLen        = input.int(21, "III SMA Length", minval=1,
     tooltip="SMA smoothing period applied to Bostian Intraday Intensity Index. Default 21 only (census authorized).")
// Bars after exit (SELL) before new BUY/re-entry; 0 disables. NOT after entries.
cooldownBars  = input.int(6, "Cooldown bars after exit", minval=0,
     tooltip="Bars after an exit (SELL) before a new BUY is allowed. 0 = disabled. Does not apply after entries.")

// Optional ATR exit (stop loss / profit / trail)
useAtrExit    = input.bool(false, "Enable optional ATR exit",
     tooltip="Enable strategy.exit with ATR-based stop. Base census Mode-A used signal-only exits.")
atrLen        = input.int(14, "ATR Length", minval=1)
atrStopMult   = input.float(3.0, "ATR Stop Multiple", minval=0.1, step=0.1,
     tooltip="Stop loss placed at entry price minus mult * ATR.")

sellQtyPct    = input.float(12.0, "Sell qty_pct (webhook)", minval=0.1, maxval=100, step=0.1,
     tooltip="Full exit within Balanced max-pos framing (12%). Used in alert() JSON.")
strategyId    = input.string("bostian-iii-sma-zero", "strategy_id for webhook")
webhookSecret = input.string("", "Webhook secret (runtime only - never publish)",
     tooltip="TradingView webhooks cannot send custom headers, so the bot reads the secret from the JSON body. Paste the Railway WEBHOOK_SECRET here on the chart only.")

// ——— Normalize ticker: strip exchange prefix → BTCUSDT-style ———
normalizeSymbol() =>
    id = syminfo.tickerid
    s = str.replace_all(id, "BINANCE:", "")
    s := str.replace_all(s, "BINANCE.US:", "")
    s := str.replace_all(s, "BYBIT:", "")
    s := str.replace_all(s, "COINBASE:", "")
    s := str.replace_all(s, "KRAKEN:", "")
    s := str.replace_all(s, "OKX:", "")
    parts = str.split(s, ":")
    s := array.size(parts) > 1 ? array.get(parts, array.size(parts) - 1) : s
    s := str.replace_all(s, "/", "")
    s := str.replace_all(s, "-", "")
    s

normSym = normalizeSymbol()

// ——— Bostian Intraday Intensity Index (III) calculation ———
rng  = high - low
iii  = rng == 0 ? 0.0 : ((2.0 * close - high - low) / rng) * volume
iiiS = ta.sma(iii, smaLen)

plot(iiiS, "III SMA", color=color.new(color.blue, 0), linewidth=2)
hline(0.0, "Zero Line", color=color.gray, linestyle=hline.style_dashed)

// ATR for optional stop
atrVal = ta.atr(atrLen)

// ——— Cooldown: bars since last exit (SELL) ———
var int lastExitBar = na
if strategy.position_size[1] > 0 and strategy.position_size <= 0
    lastExitBar := bar_index

cooldownOk = cooldownBars == 0 or na(lastExitBar) or (bar_index - lastExitBar) >= cooldownBars

// ——— Signals (price / strategy state only — no bot open-state) ———
iiiCrossUp   = ta.crossover(iiiS, 0.0)
iiiCrossDown = ta.crossunder(iiiS, 0.0)

longCondition = iiiCrossUp and cooldownOk
exitCondition = iiiCrossDown and strategy.position_size > 0

if longCondition
    strategy.entry("Long", strategy.long)

// Optional ATR exit execution in strategy tester
if useAtrExit and strategy.position_size > 0
    strategy.exit("ATR Exit", "Long", stop=strategy.position_avg_price - atrStopMult * atrVal)

if exitCondition
    strategy.close("Long")

// Dynamic webhook JSON (normalized symbol). Used by alert() once per bar close.
// Per PAPER_PARAMS: Buys OMIT qty/qty_pct (bot defaults to RISK_PER_TRADE_PCT 2.5). Sells use qty_pct 12.
// Exact alert_id shape: {strategy_id}-{SYMBOL}-{{time}}-{buy|sell}
// Header auth (X-Webhook-Secret) is preferred; no secret embedded in Pine.
// Bar-open time in UTC ISO-8601 (same value {{time}} gives). Placeholders are NOT expanded inside alert() messages,
// so the alert_id time is built in Pine; otherwise every alert_id would contain the literal text {{time}}.
barTimeIso = str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
secretPart = webhookSecret == "" ? "" : ',"secret":"' + webhookSecret + '"'
buyJson = '{"symbol":"' + normSym + '","side":"buy","strategy_id":"' + strategyId + '","price":' + str.tostring(close) + ',"alert_id":"' + strategyId + '-' + normSym + '-' + barTimeIso + '-buy"' + secretPart + '}'
sellJson = '{"symbol":"' + normSym + '","side":"sell","qty_pct":' + str.tostring(sellQtyPct) + ',"strategy_id":"' + strategyId + '","price":' + str.tostring(close) + ',"alert_id":"' + strategyId + '-' + normSym + '-' + barTimeIso + '-sell"' + secretPart + '}'

if longCondition
    alert(buyJson, alert.freq_once_per_bar_close)

if exitCondition
    alert(sellJson, alert.freq_once_per_bar_close)

// ——— alertconditions (create TWO TradingView alerts on these) ———
// Buy webhook JSON template (omits qty/qty_pct -> bot uses RISK_PER_TRADE_PCT 2.5%):
// {
//   "symbol": "BTCUSDT",
//   "side": "buy",
//   "strategy_id": "bostian-iii-sma-zero",
//   "price": "{{close}}",
//   "alert_id": "bostian-iii-sma-zero-BTCUSDT-{{time}}-buy"
// }
alertcondition(longCondition, title="Bostian III SMA21 Buy",
     message='{"symbol":"BTCUSDT","side":"buy","strategy_id":"bostian-iii-sma-zero","price":"{{close}}","alert_id":"bostian-iii-sma-zero-BTCUSDT-{{time}}-buy"}')

// Sell webhook JSON template (qty_pct 12 clears max position):
alertcondition(exitCondition and strategy.position_size > 0, title="Bostian III SMA21 Sell",
     message='{"symbol":"BTCUSDT","side":"sell","qty_pct":12,"strategy_id":"bostian-iii-sma-zero","price":"{{close}}","alert_id":"bostian-iii-sma-zero-BTCUSDT-{{time}}-sell"}')

// Visual markers
plotshape(longCondition, title="Buy", style=shape.triangleup, location=location.belowbar, size=size.tiny, color=color.lime)
plotshape(exitCondition, title="Sell", style=shape.triangledown, location=location.abovebar, size=size.tiny, color=color.red)
